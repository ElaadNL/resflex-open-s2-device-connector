# Copy this file to .env and fill all values.
# Do not commit .env (it is gitignored).

# Wi-Fi settings (WPA2/WPA3-Personal)
WIFI_SSID=YOUR_WIFI_SSID
WIFI_PASSWORD=YOUR_WIFI_PASSWORD

# CEM S2 PEBC endpoint (fallback if DNS-SD discovery fails). Leave empty to use DNS-SD discovery.
## e.g. https://homeassistant.local:8123/api/s2_pebc
CEM_S2_INTEGRATION_URL=

# Pairing token. Two options:
# 1. RM-initiated: token from the CEM
# 2. Long-poll (CEM initiates): the RM's own static token (min 6 chars).
PAIRING_ACCESS_TOKEN=REPLACE_WITH_TOKEN
